# =============================================
# trade-it-easy 云服务器定时任务（crontab）
# =============================================
# 部署位置：Linux 云服务器（Ubuntu），时区必须为 Asia/Shanghai
# 校验时区：timedatectl status | grep "Time zone"
#           若非 Asia/Shanghai，执行：
#             sudo timedatectl set-timezone Asia/Shanghai
#
# 前置依赖（一次性）：
#   cd /root/trade-it-easy
#   conda create -n rt python=3.14
#   /root/miniconda/envs/rt/bin/pip install -r requirements.txt
#   /root/miniconda/envs/rt/bin/pip install ./wheels/AmazingData-1.1.9-cp314-none-any.whl ./wheels/tgw-1.0.9.2-py3-none-any.whl
#   配置 .env（拷贝本地 .env，含 MX_APIKEY/TGW_* 等）
#   解释器写死为 /root/miniconda/envs/rt/bin/python（勿用 ./.venv/bin/python）
#
# 行尾必须是 LF：本文件在 Windows 上编辑提交，仓库以 .gitattributes 固定 eol=lf。
# 若是 CRLF，cron 安装时报 "bad minute"；修复：sed -i 's/\r$//' deploy/crontab.server
#
# 使用方法：
#   crontab deploy/crontab.server     # 安装
#   crontab -l                        # 查看
#   crontab -r                        # 移除
#
# 注意：
#   - 所有命令都在项目根目录执行
#   - 日志由脚本自行写入 logs/<prefix>.log（含 _debug.log），cron 不重复重定向；
#     stdout 丢弃，仅 stderr（启动失败/未捕获异常）追加到 logs/cron_error.log
#   - flock 防止任务重入（节假日/周末任务重叠等）
#   - 质量动量与跨资产动量共用 14:40 一轮，串行执行：先 etf_rotation（约 1 分钟），
#     后 quality_pool（约 7 分钟，T-1 财务扫描占大头）。质量动量必须在 15:00 前拿到
#     当天执行快照（now-120s 时效窗，收盘后无新成交 → fail-closed 不出单），
#     不得再往后挪；两个任务各自 flock，任一失败不影响另一个。
#     flock 覆盖完整流程，脚本检查交易日，cron 用 1-5 限定即可
# =============================================

# ── 卫星仓：每交易日 14:40 先跨资产动量、后质量动量，各自更新实际账户建议并推送 ──
40 14 * * 1-5 cd /root/trade-it-easy && { flock -n /tmp/etf-rotation.lock /root/miniconda/envs/rt/bin/python etf_rotation.py; flock -n /tmp/quality-pool.lock /root/miniconda/envs/rt/bin/python quality_pool.py; } > /dev/null 2>> logs/cron_error.log

# ── 收盘成绩：当日18:30（北京时间）采集投资账户当日收盘估值，并回补最近5个交易日不完整记录；
#    股票和 ETF 优先用 AmazingData，ETF 缺价时依次改用东财、新浪；
#    场外净值取估值日或之前最新已公布值，晚间未公布沿用前一日净值、不阻塞当日成绩；
#    仅收盘价/净值完全缺失才标待估值（次日晚回补），成绩曲线只取完整记录；
#    估值与定投补记后，生成权益/固收组合再平衡建议，有操作才保存并推送报告──
30 18 * * 1-5 cd /root/trade-it-easy && flock -n /tmp/portfolio-report.lock /root/miniconda/envs/rt/bin/python portfolio_report.py > /dev/null 2>> logs/cron_error.log
